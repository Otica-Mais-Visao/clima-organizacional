{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:loja(mv-[a-z-]+|gm-[a-z-]+)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] }
  ]
}
